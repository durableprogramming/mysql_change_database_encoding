#!/bin/bash
# Copyright 2024, Durable Programming, LLC. All rights reserved.
# See LICENSE for license details.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"

# Default values
VERSION=""
REGISTRY="docker.io"
IMAGE_NAME="durableprogramming/mysql-change-database-encoding"
PUSH=false
PLATFORMS="linux/amd64,linux/arm64"

# Parse command line arguments
while [[ $# -gt 0 ]]; do
    case $1 in
        -v|--version)
            VERSION="$2"
            shift 2
            ;;
        -r|--registry)
            REGISTRY="$2"
            shift 2
            ;;
        -i|--image)
            IMAGE_NAME="$2"
            shift 2
            ;;
        -p|--push)
            PUSH=true
            shift
            ;;
        --platforms)
            PLATFORMS="$2"
            shift 2
            ;;
        -h|--help)
            echo "Usage: $0 --version VERSION [OPTIONS]"
            echo ""
            echo "Build Docker image for mysql-change-database-encoding"
            echo ""
            echo "Options:"
            echo "  -v, --version VERSION     Version tag for the image (required)"
            echo "  -r, --registry REGISTRY   Docker registry (default: docker.io)"
            echo "  -i, --image IMAGE         Image name (default: durableprogramming/mysql-change-database-encoding)"
            echo "  -p, --push               Push image to registry after build"
            echo "  --platforms PLATFORMS    Target platforms (default: linux/amd64,linux/arm64)"
            echo "  -h, --help               Show this help message"
            exit 0
            ;;
        *)
            echo "Unknown option: $1" >&2
            exit 1
            ;;
    esac
done

if [[ -z "$VERSION" ]]; then
    echo "Error: Version is required. Use --version VERSION" >&2
    exit 1
fi

# Construct full image name
FULL_IMAGE_NAME="${REGISTRY}/${IMAGE_NAME}"

echo "Building Docker image: ${FULL_IMAGE_NAME}:${VERSION}"
echo "Platforms: $PLATFORMS"

cd "$PROJECT_DIR"

# Build arguments
BUILD_ARGS=(
    "--platform" "$PLATFORMS"
    "-t" "${FULL_IMAGE_NAME}:${VERSION}"
    "-t" "${FULL_IMAGE_NAME}:latest"
)

if [[ "$PUSH" == "true" ]]; then
    BUILD_ARGS+=("--push")
    echo "Will push to registry after build"
fi

# Build the image
docker buildx build "${BUILD_ARGS[@]}" .

if [[ "$PUSH" != "true" ]]; then
    echo "Docker image built successfully:"
    docker images "${FULL_IMAGE_NAME}" | head -2
    echo ""
    echo "To test the image:"
    echo "docker run --rm ${FULL_IMAGE_NAME}:${VERSION} --help"
    echo ""
    echo "To push the image:"
    echo "$0 --version $VERSION --push"
fi